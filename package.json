{
  "name": "@dr-co/dsh-log-sink",
  "version": "0.1.3",
  "description": "DSH plugin: send cordis logger output to stdout/journald and to a file, so plugin diagnostics stop disappearing into the in-memory buffer",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "logging"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unera/dsh-log-sink.git"
  },
  "homepage": "https://github.com/unera/dsh-log-sink#readme",
  "bugs": {
    "url": "https://github.com/unera/dsh-log-sink/issues"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5 || ^4.1.0"
  }
}
